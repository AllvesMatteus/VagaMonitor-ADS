# =====================================================
# VagaMonitor — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env no Git
# =====================================================

# --- Telegram Bot ---
# Crie um bot em: https://t.me/BotFather
# Obtenha o chat_id: https://t.me/userinfobot
TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# --- Banco de dados (PostgreSQL para produção) ---
# Para desenvolvimento local com H2, não precisa definir estas variáveis.
# Para produção (ex: Railway, Render, Supabase):
DB_URL=jdbc:postgresql://host:5432/vagamonitor
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_DRIVER=org.postgresql.Driver
